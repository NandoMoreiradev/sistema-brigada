generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================= PLATAFORMA / TENANT =================================

enum Role {
  SUPER_ADMIN
  GROUP_ADMIN
  ORG_ADMIN
  ORG_USER
}

model Organization {
  id                                 String    @id @default(cuid())
  name                               String
  subdomain                          String?   @unique
  logoUrl                            String?
  isMatrix                           Boolean   @default(false)
  parentOrganizationId               String?
  groupName                          String?
  enabledModules                     String[]  @default([])
  /// Chave Resend própria da academia. Quando ausente, o envio cai para
  /// RESEND_API_KEY (conta global da plataforma) — ver EmailSenderFactory.
  resendApiKey                       String?
  emailFromAddress                   String?
  emailFromName                      String?
  /// Autocadastro público (/register/:token) — desativado por padrão, cada academia liga
  /// explicitamente (ver OrganizationsService). Token não é removido ao desativar, só ao
  /// regenerar, pra reativar reaproveitar o mesmo link já compartilhado.
  publicRegistrationEnabled          Boolean   @default(false)
  publicRegistrationToken            String?   @unique
  /// Subconjunto de PUBLIC_REGISTRATION_FIELD_CATALOG (common/constants) exibido no
  /// formulário público desta academia — não é form-builder livre, é toggle sobre um
  /// catálogo fixo de campos de StudentProfile.
  publicRegistrationFields           String[]  @default([])
  /// Mesmo catálogo, escolhido separadamente para quem entra como instrutor / equipe (o de cima é o do aluno).
  publicRegistrationFieldsInstructor String[]  @default([])
  publicRegistrationFieldsStaff      String[]  @default([])
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
  deletedAt                          DateTime?

  parentOrganization          Organization?                @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations          Organization[]               @relation("OrgHierarchy")
  users                       User[]
  roleAssignments             RoleAssignment[]
  userAccess                  UserOrganizationAccess[]
  courses                     Course[]
  events                      Event[]
  rooms                       Room[]
  instructorTeams             InstructorTeam[]
  scheduleTemplates           ScheduleTemplate[]
  certificateTemplate         CertificateTemplate?
  certificateReminderSettings CertificateReminderSettings?
  emailTemplates              EmailTemplate[]
  communications              Communication[]
  registrationRequests        RegistrationRequest[]
  registrationInvites         RegistrationInvite[]

  @@index([parentOrganizationId])
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  password               String
  name                   String
  phone                  String?
  role                   Role      @default(ORG_USER)
  organizationId         String?
  avatarUrl              String?
  directPermissions      String[]  @default([])
  isTwoFactorEnabled     Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]  @default([])
  systemRoleId           String?
  isSuperAdminRoot       Boolean   @default(false)
  /// Usado na página pública do crachá (/badge/:token)
  publicBadgeToken       String    @unique @default(uuid())
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  organization                   Organization?            @relation(fields: [organizationId], references: [id])
  systemRole                     SystemRole?              @relation(fields: [systemRoleId], references: [id])
  refreshTokens                  RefreshToken[]
  roleAssignments                RoleAssignment[]         @relation("RoleAssignmentToUser")
  allowedOrganizations           UserOrganizationAccess[]
  availabilities                 UserAvailability[]
  timeOffs                       TimeOff[]
  studentProfile                 StudentProfile?
  staffMember                    StaffMember?
  instructorAssignments          CourseInstructor[]
  teamMemberships                InstructorTeamMember[]
  activityAssignments            CourseActivityAssignee[]
  moduleAssignments              CourseModuleInstructor[]
  sessionAssignments             ClassSessionInstructor[]
  classLogs                      ClassLog[]
  lessonProgress                 LessonProgress[]
  meetingAttendances             MeetingAttendance[]
  integrations                   UserIntegration[]
  notifications                  Notification[]
  createdEmailTemplates          EmailTemplate[]          @relation("EmailTemplateCreator")
  externalCertifications         ExternalCertification[]
  createdOccurrenceReports       OccurrenceReport[]
  createdCommunications          Communication[]          @relation("CommunicationCreator")
  communicationRecipients        CommunicationRecipient[]
  reviewedRegistrationRequests   RegistrationRequest[]    @relation("RegistrationRequestReviewedBy")
  createdRegistrationInvites     RegistrationInvite[]     @relation("RegistrationInviteCreatedBy")
  personProfile                  PersonProfile?
  createdFromRegistrationRequest RegistrationRequest?     @relation("RegistrationRequestCreatedUser")

  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOrganizationAccess {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String
  roleAssignmentId String?
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignment RoleAssignment? @relation(fields: [roleAssignmentId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleAssignmentId])
}

model RoleAssignment {
  id             String    @id @default(cuid())
  name           String
  organizationId String
  isDeletable    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  Permission[]
  users        User[]                   @relation("RoleAssignmentToUser")
  accessGrants UserOrganizationAccess[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// id é string livre (ex: "courses:manage", "events:designate"), não cuid.
model Permission {
  id          String           @id
  name        String
  description String?
  module      String
  group       String           @default("Geral")
  roles       RoleAssignment[]
}

model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// ex: ["sys:organizations:manage"]
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================================= ACADÊMICO =================================

enum PioneerStatus {
  AUXILIARY
  REGULAR
}

/// Dados pessoais de QUALQUER pessoa da academia (aluno, instrutor, equipe...). Antes viviam em
/// StudentProfile, o que impedia instrutor/equipe de ter batismo, nascimento etc.
model PersonProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  organizationId  String
  birthDate       DateTime?
  gender          String?
  /// Data de batismo
  baptismDate     DateTime?
  /// Ausente = não é pioneiro
  pioneerStatus   PioneerStatus?
  /// Nomes das petições assinadas (ex: "Pioneiro regular"); vazio = nenhuma
  signedPetitions String[]       @default([])
  /// Profissão ou área de estudo
  profession      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Só o que é de aluno (saúde, responsável, matrículas). Dados pessoais ficam em PersonProfile.
model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  healthInfo     Json?
  guardianName   String?
  guardianPhone  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([organizationId])
}

model Course {
  id                           String    @id @default(cuid())
  /// Course é o "detalhe" do Event quando kind = TURMA
  eventId                      String    @unique
  organizationId               String
  /// ex: "Brigada de Incêndio", "Primeiros Socorros"
  category                     String?
  vacancies                    Int?
  /// Critério de emissão automática do certificado (decisão 17: configurável por turma)
  minAttendancePercent         Int       @default(75)
  requireAllLessonsWatched     Boolean   @default(true)
  /// Validade em meses do certificado emitido nesta turma (decisão 19)
  recyclingValidityMonths      Int?
  recommendedRecyclingCourseId String?
  /// Conteúdo programático (texto livre) — vira uma 2ª página no PDF do
  /// certificado quando preenchido (ver certificate-pdf.service.ts). Texto
  /// livre em vez de uma estrutura rígida de módulos/tópicos porque cursos
  /// de brigada variam muito de formato (decisão 17) — a academia escreve do
  /// jeito que já usa na ementa impressa dela.
  syllabus                     String?   @db.Text
  /// Nome do curso como sai no certificado ({{curso.nome}}). Vazio = usa o título da
  /// turma (Event.title), que costuma ser um nome interno ("Brigadistas 11/10").
  certificateTitle             String?
  /// Carga horária em horas ({{curso.cargaHoraria}} no certificado)
  workloadHours                Int?
  /// Sala onde a turma costuma ter aula: vem pré-selecionada ao agendar uma aula nova.
  /// Cada aula guarda a própria sala (`ClassSession.roomId`), então trocar aqui não mexe nas já agendadas.
  defaultRoomId                String?
  active                       Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  event                      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization               Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendedRecyclingCourse Course?            @relation("RecyclingCourse", fields: [recommendedRecyclingCourseId], references: [id])
  recycledByCourses          Course[]           @relation("RecyclingCourse")
  defaultRoom                Room?              @relation(fields: [defaultRoomId], references: [id], onDelete: SetNull)
  groups                     CourseGroup[]
  activities                 CourseActivity[]
  scheduleBlocks             ScheduleBlock[]
  instructors                CourseInstructor[]
  sessions                   ClassSession[]
  modules                    CourseModule[]
  enrollments                Enrollment[]

  @@index([organizationId])
}

model CourseInstructor {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Room {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  capacity       Int?
  active         Boolean @default(true)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     ClassSession[]
  courses      Course[]
  groups       CourseGroup[]
  activities   CourseActivity[]

  @@unique([organizationId, name])
}

model ClassSession {
  id           String   @id @default(cuid())
  courseId     String
  date         DateTime @db.Date
  startTime    String   @db.Char(5)
  endTime      String   @db.Char(5)
  roomId       String?
  /// Assunto/tema da aula do dia (ex.: "Primeiros socorros — RCP"), texto livre.
  topic        String?
  /// Grupo da turma a que a aula se destina (chamada só com os alunos dele). Vazio = turma inteira.
  groupId      String?
  /// Gerada pela programação (um período do dia de um grupo): o horário é mantido pela
  /// programação, não editado à mão. Ver course-schedule.service.ts.
  fromSchedule Boolean  @default(false)
  createdAt    DateTime @default(now())

  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room        Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  group       CourseGroup?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  /// Um diário por professor: dois professores na mesma aula não se sobrescrevem.
  classLogs   ClassLog[]
  /// Professores escalados nesta aula. Vazio = qualquer instrutor da turma pode lançar chamada/diário.
  instructors ClassSessionInstructor[]

  @@index([courseId])
  @@index([date])
  @@index([roomId])
}

// ============================ PROGRAMAÇÃO DA TURMA ============================
// Treinamento com a turma dividida em grupos que fazem um rodízio pelas mesmas atividades
// (ex.: Sala 1, Sala 2 e Sala 3 passando pelas mesmas estações em ordens diferentes).
// - Grupo (CourseGroup) é QUEM: um conjunto de alunos. Sala (Room) é ONDE. O grupo tem uma
//   sala base, mas passa parte do dia em outros lugares (ex.: Área da prática).
// - Atividade (CourseActivity) é cadastrada uma vez na turma: duração, local fixo e responsáveis.
// - A programação de um grupo num dia é a sequência de blocos (ScheduleBlock); os horários são
//   calculados a partir do início do dia e da duração de cada atividade.
// - A chamada é por período: a programação gera uma ClassSession (`fromSchedule`) para cada
//   trecho entre refeições (manhã/tarde).

enum ScheduleActivityKind {
  ACTIVITY
  BREAK
  MEAL
}

model CourseGroup {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  /// Sala base: local das atividades que não têm local fixo.
  roomId    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  sessions       ClassSession[]
  scheduleBlocks ScheduleBlock[]

  @@unique([courseId, name])
  @@index([courseId])
}

/// Equipe fixa de instrutores (ex.: "Equipe de Ana"). É da academia: serve a todas as turmas.
model InstructorTeam {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members           InstructorTeamMember[]
  activityAssignees CourseActivityAssignee[]

  @@unique([organizationId, name])
}

model InstructorTeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team InstructorTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model CourseActivity {
  id              String               @id @default(cuid())
  courseId        String
  title           String
  kind            ScheduleActivityKind @default(ACTIVITY)
  durationMinutes Int
  /// Local fixo (ex.: Área da prática). Vazio = sala base do grupo.
  roomId          String?
  order           Int                  @default(0)
  createdAt       DateTime             @default(now())

  course    Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room      Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignees CourseActivityAssignee[]
  blocks    ScheduleBlock[]

  @@index([courseId])
}

/// Responsável por uma atividade: uma equipe OU uma pessoa (exatamente um dos dois).
model CourseActivityAssignee {
  id         String  @id @default(cuid())
  activityId String
  teamId     String?
  userId     String?

  activity CourseActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  team     InstructorTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model ScheduleBlock {
  id         String   @id @default(cuid())
  courseId   String
  /// Vazio = programação da turma inteira (turma sem grupos).
  groupId    String?
  date       DateTime @db.Date
  order      Int
  activityId String
  /// Calculados (início do dia + durações anteriores) e guardados para checar conflitos.
  startTime  String   @db.Char(5)
  endTime    String   @db.Char(5)

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group    CourseGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity CourseActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
  @@index([date])
}

/// Programação inteira (grupos, atividades e ordem de cada grupo) salva para reaproveitar em
/// turmas novas. `data` é uma cópia, não referência: apagar a turma de origem não afeta o modelo.
model ScheduleTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model ClassLog {
  id              String   @id @default(cuid())
  classSessionId  String
  content         String   @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, createdByUserId])
  @@index([createdByUserId])
}

/// Quem leciona a aula presencial do dia. Sempre um CourseInstructor da turma (validado no service).
model ClassSessionInstructor {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Enrollment {
  id               String           @id @default(cuid())
  studentProfileId String
  courseId         String
  organizationId   String
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  /// Grupo da turma (ex.: "Sala 1"). A presença do aluno conta só as aulas do grupo dele e as da turma inteira.
  groupId          String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group          CourseGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendances    Attendance[]
  certificate    Certificate?

  @@unique([studentProfileId, courseId])
  @@index([courseId])
  @@index([organizationId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENT
}

model Attendance {
  id             String           @id @default(cuid())
  enrollmentId   String
  classSessionId String
  status         AttendanceStatus
  createdAt      DateTime         @default(now())

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, classSessionId])
  @@index([classSessionId])
}

// ================================= VÍDEO-AULAS =================================
// Adaptado de TrainingModule/TrainingLesson/TrainingProgress do maskotCrmEdu,
// escopado por Course (lá era conteúdo global de treinamento interno da equipe).

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  title    String
  order    Int     @default(0)
  active   Boolean @default(true)

  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]
  /// Professores responsáveis por este módulo/assunto. Vazio = qualquer instrutor da turma edita as aulas.
  instructors CourseModuleInstructor[]

  @@index([courseId])
}

/// Responsável(is) por um módulo. Sempre um CourseInstructor da turma (validado no service).
model CourseModuleInstructor {
  id        String   @id @default(cuid())
  moduleId  String
  userId    String
  createdAt DateTime @default(now())

  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@index([userId])
}

model CourseLesson {
  id       String  @id @default(cuid())
  moduleId String
  title    String
  content  String? @db.Text
  duration Int?
  order    Int     @default(0)
  active   Boolean @default(true)

  module   CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  videos   CourseLessonVideo[]
  files    CourseLessonFile[]

  @@index([moduleId])
}

/// Vídeo de uma aula (uma aula pode ter vários). `storageKey` presente = arquivo enviado pro R2
/// (contexto 'course-lessons', tocado no player embutido e acompanhado sozinho); ausente = link
/// externo colado, que abre em nova aba.
model CourseLessonVideo {
  id         String   @id @default(cuid())
  lessonId   String
  title      String?
  url        String
  storageKey String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

/// Material de apoio de uma vídeo-aula (PDF, apostila, planilha, slides...). Mesmo formato de
/// EventFile: `storageKey` vem de upload via presigned URL (contexto 'course-lesson-files') e
/// `externalUrl` guarda a URL pública do arquivo.
model CourseLessonFile {
  id               String   @id @default(cuid())
  lessonId         String
  name             String
  storageKey       String?
  externalUrl      String?
  mimeType         String?
  size             Int?
  uploadedByUserId String
  createdAt        DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  /// Vídeos enviados (CourseLessonVideo com storageKey) que o aluno já assistiu até o fim. A aula
  /// vira `completed` sozinha quando todos os vídeos enviados dela estão aqui.
  watchedVideoIds String[]  @default([])

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ================================= EVENTO POLIMÓRFICO =================================
// Event = tronco (tipo/local/data/unidade). Cada kind tem uma tabela-filha 1:1:
// TURMA -> Course · ASSEMBLEIA/CONGRESSO -> EventOperation · REUNIAO -> Meeting

enum EventKind {
  TURMA
  ASSEMBLEIA
  CONGRESSO
  REUNIAO
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id              String      @id @default(cuid())
  organizationId  String
  kind            EventKind
  title           String
  location        String?
  startDate       DateTime
  endDate         DateTime?
  status          EventStatus @default(SCHEDULED)
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course?
  operation    EventOperation?
  meeting      Meeting?
  files        EventFile[]

  @@index([organizationId])
  @@index([kind])
  @@index([startDate])
}

/// Arquivos/links anexados a qualquer evento (pauta, ata, comprovantes) — genérico,
/// evita reimplementar o módulo Drive inteiro do Maskot para um caso de uso bem mais simples.
model EventFile {
  id               String   @id @default(cuid())
  eventId          String
  name             String
  storageKey       String?
  externalUrl      String?
  mimeType         String?
  uploadedByUserId String
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---- Assembleia / congresso ----

model EventOperation {
  id                     String  @id @default(cuid())
  eventId                String  @unique
  /// Decisão 15: só contagem agregada do público, sem registro nominal
  estimatedAudienceCount Int?
  notes                  String? @db.Text
  /// Planta baixa do local (imagem) onde os postos de atuação são plotados — ver EventPost.posX/posY
  floorPlanKey           String?
  floorPlanUrl           String?

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  designations      Designation[]
  occurrenceReports OccurrenceReport[]
  posts             EventPost[]
  teams             Team[]
  shifts            EventShift[]
  floorPlans        EventFloorPlan[]
}

/// Planta baixa de uma área do evento (Térreo, Mezanino, Área externa...). As plantas funcionam ao
/// mesmo tempo: cada posto pertence a UMA planta e sua posição (posX/posY) vale naquela imagem.
/// Até 10 por evento; a partir da segunda o nome é obrigatório (validado no service).
/// EventOperation.floorPlanKey/floorPlanUrl são o formato antigo (uma planta só) e ficam só como
/// legado: a migration copia cada uma para uma EventFloorPlan.
model EventFloorPlan {
  id               String   @id @default(cuid())
  eventOperationId String
  name             String
  imageKey         String?
  imageUrl         String
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  posts          EventPost[]

  @@index([eventOperationId])
}

/// Turno do evento (ex.: "Dia 1 · Manhã · 08:00–12:00"). Os turnos são os MESMOS para todos os postos;
/// cada pessoa é escalada em um ou mais turnos (manhã num dia, o dia todo em outro...). O "dia" é
/// derivado do início do turno no fuso do app — não existe tabela de dias.
/// Designation.shiftStart/shiftEnd continuam gravados (cópia do turno) para "minhas escalas" e para o
/// conflito de horário entre eventos não dependerem desta tabela.
model EventShift {
  id               String   @id @default(cuid())
  eventOperationId String
  name             String
  start            DateTime
  end              DateTime
  createdAt        DateTime @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  designations   Designation[]

  @@unique([eventOperationId, start, end])
  @@index([eventOperationId])
}

/// Posto de atuação (local físico) dentro do evento — ex.: "Portão A", "Palco", "Enfermaria".
/// posX/posY são relativos (0 a 1) à imagem da planta baixa, pra não depender da resolução da imagem.
model EventPost {
  id               String   @id @default(cuid())
  eventOperationId String
  name             String
  capacity         Int?
  notes            String?  @db.Text
  posX             Float?
  posY             Float?
  /// Planta onde o posto é plotado (posX/posY são relativos a ela). Nulo = posto ainda sem planta.
  floorPlanId      String?
  createdAt        DateTime @default(now())

  eventOperation EventOperation  @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  floorPlan      EventFloorPlan? @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  designations   Designation[]

  @@index([eventOperationId])
  @@index([floorPlanId])
}

/// Agrupamento nomeado de designações do MESMO evento (decisão do produto: "dupla"/"trio" não é
/// um vínculo permanente entre pessoas — é só um rótulo por ocasião de escala. A mesma pessoa pode
/// estar numa Team com Fulano de manhã e em outra Team, com Beltrano, à tarde, no mesmo evento).
model Team {
  id               String   @id @default(cuid())
  eventOperationId String
  name             String
  createdAt        DateTime @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  designations   Designation[]

  @@index([eventOperationId])
}

enum DesignationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Designation {
  id               String            @id @default(cuid())
  eventOperationId String
  staffMemberId    String
  /// BRIGADISTA, BOMBEIRO, COORDENADOR...
  role             String
  /// Decisão 14: escala com turnos/horários dentro do evento
  shiftStart       DateTime
  shiftEnd         DateTime
  status           DesignationStatus @default(PENDING)
  postId           String?
  teamId           String?
  /// Turno do evento. shiftStart/shiftEnd acima são a cópia dos horários dele.
  shiftId          String?
  createdAt        DateTime          @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  staffMember    StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  post           EventPost?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shift          EventShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([eventOperationId])
  @@index([staffMemberId])
  @@index([postId])
  @@index([teamId])
}

model OccurrenceReport {
  id               String   @id @default(cuid())
  eventOperationId String
  /// MEDICAL, SAFETY, BEHAVIORAL, GENERAL...
  type             String
  title            String
  description      String?  @db.Text
  /// URL pública (R2) de um áudio gravado na hora pra registrar a ocorrência, opcional.
  audioUrl         String?
  createdByUserId  String
  createdAt        DateTime @default(now())

  eventOperation EventOperation         @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation(fields: [createdByUserId], references: [id])
  files          OccurrenceReportFile[]

  @@index([eventOperationId])
}

/// Anexo (foto, documento) de um relatório de ocorrência — além do áudio único já suportado em `OccurrenceReport.audioUrl`.
model OccurrenceReportFile {
  id                 String   @id @default(cuid())
  occurrenceReportId String
  name               String
  storageKey         String?
  externalUrl        String?
  mimeType           String?
  uploadedByUserId   String
  createdAt          DateTime @default(now())

  occurrenceReport OccurrenceReport @relation(fields: [occurrenceReportId], references: [id], onDelete: Cascade)

  @@index([occurrenceReportId])
}

// ---- Reunião periódica + Google Meet ----

model Meeting {
  id            String  @id @default(cuid())
  eventId       String  @unique
  agenda        String? @db.Text
  /// Ata da reunião
  minutes       String? @db.Text
  meetUrl       String?
  googleEventId String?

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances MeetingAttendance[]
}

model MeetingAttendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus @default(ABSENT)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

// ================================= STAFF (BRIGADISTA/BOMBEIRO) =================================

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffMember {
  id               String      @id @default(cuid())
  /// Decisão 8: mesmo User do sistema, papel acumulado (não duplica cadastro)
  userId           String      @unique
  organizationId   String
  status           StaffStatus @default(ACTIVE)
  /// Decisão 9: promoção para staff é sempre manual, feita pelo admin
  approvedByUserId String
  approvedAt       DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  designations Designation[]

  @@index([organizationId])
}

/// Decisão 32: certificação/qualificação prévia registrada manualmente pelo
/// admin (ex: já é Bombeiro Civil ou Brigadista Intermediário antes de entrar
/// na academia) — presa direto no `User`, não em `StaffMember` (decisão 10
/// original), porque é um fato sobre a pessoa, não sobre o papel dela: um
/// professor/instrutor que nunca foi promovido a staff de atuação também
/// pode ter uma qualificação prévia registrada.
model ExternalCertification {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  issuingOrg         String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  proofFileKey       String?
  registeredByUserId String
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ================================= CERTIFICADO / CRACHÁ =================================
// O "crachá" não é uma tabela própria: a página pública /badge/:token resolve por
// User.publicBadgeToken e lista os Certificate válidos daquele usuário.

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

model Certificate {
  id                        String            @id @default(cuid())
  enrollmentId              String            @unique
  organizationId            String
  issuedAt                  DateTime          @default(now())
  /// Decisões 19/20: reciclagem ativa + válido em toda a rede da organização
  expiresAt                 DateTime?
  status                    CertificateStatus @default(VALID)
  pdfKey                    String?
  /// Decisão 16: emissão automática por critérios da turma
  issuedAutomatically       Boolean           @default(true)
  recycledFromCertificateId String?
  /// Código de verificação impresso no PDF e usado na página pública /validar/:code.
  /// Aleatório (base32 Crockford, 12 caracteres, guardado sem hífens) e não sequencial,
  /// para não dar pra enumerar os certificados — e com eles os nomes dos alunos.
  code                      String            @unique
  revokedAt                 DateTime?
  revokedReason             String?
  revokedByUserId           String?

  enrollment               Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recycledFromCertificate  Certificate?          @relation("Recycling", fields: [recycledFromCertificateId], references: [id])
  recycledIntoCertificates Certificate[]         @relation("Recycling")
  reminders                CertificateReminder[]

  @@index([organizationId])
  @@index([expiresAt])
}

enum CertificateReminderDigestFrequency {
  OFF
  DAILY
  /// Às segundas-feiras
  WEEKLY
}

/// Lembretes de vencimento de certificado, configurados por academia (ver
/// certificate-reminders.service.ts). Academia sem registro usa os defaults abaixo —
/// que reproduzem o comportamento anterior: um aviso 30 dias antes, às 8h.
model CertificateReminderSettings {
  id                         String                             @id @default(cuid())
  organizationId             String                             @unique
  enabled                    Boolean                            @default(true)
  /// Dias antes do vencimento em que o aluno é lembrado (0 = no próprio dia)
  daysBefore                 Int[]                              @default([30])
  /// Dias depois do vencimento (e-mail CERTIFICATE_EXPIRED)
  daysAfter                  Int[]                              @default([])
  /// Hora do envio, 0–23, no fuso America/Sao_Paulo
  sendHour                   Int                                @default(8)
  includeRecyclingSuggestion Boolean                            @default(true)
  /// Resumo para a gestão: lista de quem vence nos próximos `digestWindowDays` dias
  digestFrequency            CertificateReminderDigestFrequency @default(OFF)
  /// Pessoas da academia (User.id) que recebem o resumo
  digestRecipientUserIds     String[]                           @default([])
  digestWindowDays           Int                                @default(30)
  lastDigestSentAt           DateTime?
  updatedAt                  DateTime                           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum CertificateReminderStatus {
  /// Em envio (também serve de trava contra duas instâncias enviando o mesmo lembrete)
  SENDING
  SENT
  FAILED
  /// Não enviado de propósito (ex.: o aluno já tem um certificado mais novo e válido)
  SKIPPED
}

/// Um lembrete por certificado e etapa. `stage`: "before:30", "after:7" ou "manual:<timestamp>".
/// A chave única é o que impede reenvio; FAILED é tentado de novo nas rodadas seguintes.
model CertificateReminder {
  id                String                    @id @default(cuid())
  certificateId     String
  organizationId    String
  stage             String
  status            CertificateReminderStatus
  attempts          Int                       @default(1)
  error             String?
  sentAt            DateTime?
  /// Preenchido só no envio manual
  triggeredByUserId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, stage])
  @@index([organizationId])
}

/// Decisão 21: personalização visual (logo, assinatura) por organização já no MVP
model CertificateTemplate {
  id                String  @id @default(cuid())
  organizationId    String  @unique
  logoUrl           String?
  signatureName     String?
  signatureImageUrl String?
  layoutConfig      Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ================================= INTEGRAÇÕES E NOTIFICAÇÕES =================================
// Faltavam no desenho original do schema (lacuna encontrada ao portar auth/google-calendar/
// notifications do maskotCrmEdu): sem UserIntegration não há onde persistir o token OAuth do
// Google Calendar por usuário, e sem Notification não há destino para os alertas de vencimento
// de certificado (decisão 19) nem para notificações gerais (designação, matrícula etc.).

model UserIntegration {
  id             String    @id @default(cuid())
  userId         String
  /// "GOOGLE_CALENDAR" por enquanto; string livre para admitir outros provedores depois
  provider       String
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  /// CERTIFICATE_EXPIRING, DESIGNATION_ASSIGNED, ENROLLMENT_CONFIRMED, GENERAL...
  type           String
  title          String
  message        String?  @db.Text
  link           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
}

// ================================= E-MAIL TRANSACIONAL =================================
// Adaptado de email-templates/ + communications/ do maskotCrmEdu, sem os pedaços que não têm
// destino neste produto: sem billing/suspensão de envio, sem verificação de domínio DNS
// in-app (a academia usa a chave Resend da própria conta, já configurada por fora), sem
// tracking de abertura/bounce por webhook, sem construtor de campanha em massa.

enum EmailTriggerType {
  ORGANIZATION_ADMIN_WELCOME
  PASSWORD_RESET
  CERTIFICATE_EXPIRING
  CERTIFICATE_EXPIRED
  USER_WELCOME
  CERTIFICATE_ISSUED
  ENROLLMENT_CONFIRMED
  DESIGNATION_ASSIGNED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  REGISTRATION_INVITE
}

/// organizationId = null -> template padrão global (usado quando a academia não tem override).
/// designJson = null -> envio usa só `body` (HTML puro); populado quando alguém salva pelo
/// construtor visual (frontend/src/components/email-builder, portado do maskotCrmEdu).
model EmailTemplate {
  id             String            @id @default(cuid())
  name           String
  subject        String
  body           String            @db.Text
  designJson     Json?
  trigger        EmailTriggerType?
  organizationId String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, trigger])
  @@index([organizationId])
  @@index([trigger])
}

// ================================= AUTOCADASTRO PÚBLICO =================================
// Formulário sem login que uma academia compartilha via link (Organization.publicRegistrationToken).
// A submissão fica pendente até alguém com registrations:manage aprovar (cria User+StudentProfile
// de verdade, via UsersService.createAccount, e dispara REGISTRATION_APPROVED) ou recusar (só
// muda o status, sem criar conta nem enviar e-mail).

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationRequest {
  id                String                    @id @default(cuid())
  organizationId    String
  name              String
  email             String
  phone             String
  /// Subconjunto de StudentProfile submetido pela pessoa — só os campos que estavam
  /// habilitados em Organization.publicRegistrationFields no momento do envio. Guardados
  /// soltos aqui (não em StudentProfile) porque a conta real só existe após aprovação.
  birthDate         DateTime?
  baptismDate       DateTime?
  pioneerStatus     PioneerStatus?
  signedPetitions   String[]                  @default([])
  profession        String?
  status            RegistrationRequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?
  /// Preenchido só quando status = APPROVED.
  createdUserId     String?                   @unique
  /// O que a pessoa pediu (link com ?tipo= ou convite) e o que o revisor aprovou de fato. O revisor
  /// sempre decide: o pedido é só uma sugestão.
  requestedKind     RegistrationKind          @default(STUDENT)
  approvedKind      RegistrationKind?
  /// Resultado do envio do e-mail de acesso (SENT/FAILED) — o envio não bloqueia a aprovação, então
  /// sem isto uma falha ficava só no log do servidor.
  accessEmailStatus String?
  accessEmailAt     DateTime?
  /// Preenchido quando a solicitação veio de um convite dirigido.
  inviteId          String?                   @unique
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("RegistrationRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdUser  User?               @relation("RegistrationRequestCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  invite       RegistrationInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ================================= COMUNICADOS (e-mail avulso) =================================
// Diferente de EmailTemplate (templates dos gatilhos automáticos acima): Communication é um
// e-mail avulso que um admin/cargo delegado (communications:manage) escreve e manda pra um
// público-alvo da própria academia (todos, alunos, equipe ou pessoas específicas). Reaproveita
// a mesma infra de renderização/envio (EmailRendererService/MailService), mas não tem o
// conceito de "padrão global" — é sempre de uma organização específica.

enum CommunicationAudience {
  ALL
  STUDENTS
  STAFF
  CUSTOM
}

enum CommunicationStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum CommunicationRecipientStatus {
  PENDING
  SENT
  FAILED
}

model Communication {
  id                     String                @id @default(cuid())
  organizationId         String
  subject                String
  body                   String                @db.Text
  designJson             Json?
  audience               CommunicationAudience @default(ALL)
  /// Só relevante quando audience = CUSTOM — ids de User escolhidos manualmente.
  customRecipientUserIds String[]              @default([])
  status                 CommunicationStatus   @default(DRAFT)
  recipientCount         Int                   @default(0)
  failedCount            Int                   @default(0)
  /// Nº de destinatários que abriram pelo menos uma vez (contagem única de pessoas, não de
  /// aberturas — ver CommunicationRecipient.openCount pro total por pessoa).
  openedCount            Int                   @default(0)
  createdByUserId        String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  sentAt                 DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                     @relation("CommunicationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  recipients   CommunicationRecipient[]

  @@index([organizationId])
}

/// Um registro por pessoa por comunicado, criado no momento do ENVIO (não existe enquanto o
/// comunicado é só rascunho) — é o log de "pra quem foi de fato mandado" + rastreio de abertura
/// via pixel (PublicCommunicationTrackingController, sem autenticação).
model CommunicationRecipient {
  id              String                       @id @default(cuid())
  communicationId String
  userId          String
  name            String
  email           String
  status          CommunicationRecipientStatus @default(PENDING)
  errorMessage    String?
  sentAt          DateTime?
  /// Primeira abertura. Sujeito a falso-positivo de clientes que pré-carregam imagens
  /// (Gmail/Apple Mail Privacy Protection) — limitação conhecida de tracking por pixel.
  openedAt        DateTime?
  openCount       Int                          @default(0)

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communicationId, userId])
  @@index([communicationId])
}

// ================================= DISPONIBILIDADE =================================
// Portado do maskotCrmEdu (UserAvailability/TimeOff) sem alteração de forma.
// Visit/EventType/ScheduleSettings NÃO foram portados: são a máquina de agendamento
// público de visita comercial do CRM (lead reserva horário com vendedor), forma
// diferente do que este produto precisa.

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model UserAvailability {
  id             String  @id @default(cuid())
  day            WeekDay
  start          String  @db.Char(5)
  end            String  @db.Char(5)
  userId         String
  organizationId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, day, start, end])
  @@index([userId])
}

model TimeOff {
  id     String   @id @default(cuid())
  start  DateTime
  end    DateTime
  reason String?
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start, end])
}

/// Papel que a pessoa entra: aluno (com perfil de aluno), instrutor (sem perfil, pronto para ser
/// escalado em turmas) ou equipe (sem perfil, já promovida a integrante da equipe).
enum RegistrationKind {
  STUDENT
  INSTRUCTOR
  STAFF
}

/// Convite dirigido a um e-mail: link único, com validade, que já define o papel. Quem se cadastra
/// por ele é aprovado na hora (o admin que convidou é quem autoriza).
model RegistrationInvite {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  name            String?
  kind            RegistrationKind @default(STUDENT)
  token           String           @unique
  createdByUserId String?
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  /// SENT/FAILED do último envio do convite por e-mail.
  emailStatus     String?
  emailSentAt     DateTime?
  createdAt       DateTime         @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("RegistrationInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  request      RegistrationRequest?

  @@index([organizationId, email])
}
