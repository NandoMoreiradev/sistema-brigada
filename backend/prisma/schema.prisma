generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================= PLATAFORMA / TENANT =================================

enum Role {
  SUPER_ADMIN
  GROUP_ADMIN
  ORG_ADMIN
  ORG_USER
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  subdomain            String?   @unique
  logoUrl              String?
  isMatrix             Boolean   @default(false)
  parentOrganizationId String?
  groupName            String?
  enabledModules       String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  parentOrganization  Organization?            @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations  Organization[]           @relation("OrgHierarchy")
  users               User[]
  roleAssignments     RoleAssignment[]
  userAccess          UserOrganizationAccess[]
  courses             Course[]
  events              Event[]
  rooms               Room[]
  certificateTemplate CertificateTemplate?

  @@index([parentOrganizationId])
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  password               String
  name                   String
  phone                  String?
  role                   Role      @default(ORG_USER)
  organizationId         String?
  avatarUrl              String?
  directPermissions      String[]  @default([])
  isTwoFactorEnabled     Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]  @default([])
  systemRoleId           String?
  isSuperAdminRoot       Boolean   @default(false)
  /// Usado na página pública do crachá (/badge/:token)
  publicBadgeToken       String    @unique @default(uuid())
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  organization          Organization?            @relation(fields: [organizationId], references: [id])
  systemRole            SystemRole?              @relation(fields: [systemRoleId], references: [id])
  refreshTokens         RefreshToken[]
  roleAssignments       RoleAssignment[]         @relation("RoleAssignmentToUser")
  allowedOrganizations  UserOrganizationAccess[]
  availabilities        UserAvailability[]
  timeOffs              TimeOff[]
  studentProfile        StudentProfile?
  staffMember           StaffMember?
  instructorAssignments CourseInstructor[]
  lessonProgress        LessonProgress[]
  meetingAttendances    MeetingAttendance[]
  integrations          UserIntegration[]
  notifications         Notification[]

  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOrganizationAccess {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String
  roleAssignmentId String?
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignment RoleAssignment? @relation(fields: [roleAssignmentId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleAssignmentId])
}

model RoleAssignment {
  id             String    @id @default(cuid())
  name           String
  organizationId String
  isDeletable    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  Permission[]
  users        User[]                   @relation("RoleAssignmentToUser")
  accessGrants UserOrganizationAccess[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// id é string livre (ex: "courses:manage", "events:designate"), não cuid.
model Permission {
  id          String           @id
  name        String
  description String?
  module      String
  group       String           @default("Geral")
  roles       RoleAssignment[]
}

model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// ex: ["sys:organizations:manage"]
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================================= ACADÊMICO =================================

model StudentProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  organizationId String
  birthDate      DateTime?
  gender         String?
  healthInfo     Json?
  guardianName   String?
  guardianPhone  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([organizationId])
}

model Course {
  id                           String    @id @default(cuid())
  /// Course é o "detalhe" do Event quando kind = TURMA
  eventId                      String    @unique
  organizationId               String
  /// ex: "Brigada de Incêndio", "Primeiros Socorros"
  category                     String?
  vacancies                    Int?
  /// Critério de emissão automática do certificado (decisão 17: configurável por turma)
  minAttendancePercent         Int       @default(75)
  requireAllLessonsWatched     Boolean   @default(true)
  /// Validade em meses do certificado emitido nesta turma (decisão 19)
  recyclingValidityMonths      Int?
  recommendedRecyclingCourseId String?
  active                       Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  event                      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization               Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendedRecyclingCourse Course?            @relation("RecyclingCourse", fields: [recommendedRecyclingCourseId], references: [id])
  recycledByCourses          Course[]           @relation("RecyclingCourse")
  instructors                CourseInstructor[]
  sessions                   ClassSession[]
  modules                    CourseModule[]
  enrollments                Enrollment[]

  @@index([organizationId])
}

model CourseInstructor {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Room {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  capacity       Int?
  active         Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     ClassSession[]

  @@unique([organizationId, name])
}

model ClassSession {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime @db.Date
  startTime String   @db.Char(5)
  endTime   String   @db.Char(5)
  roomId    String?
  createdAt DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  classLog    ClassLog?

  @@index([courseId])
  @@index([date])
  @@index([roomId])
}

model ClassLog {
  id              String   @id @default(cuid())
  classSessionId  String   @unique
  content         String   @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Enrollment {
  id               String           @id @default(cuid())
  studentProfileId String
  courseId         String
  organizationId   String
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  certificate    Certificate?

  @@unique([studentProfileId, courseId])
  @@index([courseId])
  @@index([organizationId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENT
}

model Attendance {
  id             String           @id @default(cuid())
  enrollmentId   String
  classSessionId String
  status         AttendanceStatus
  createdAt      DateTime         @default(now())

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, classSessionId])
  @@index([classSessionId])
}

// ================================= VÍDEO-AULAS =================================
// Adaptado de TrainingModule/TrainingLesson/TrainingProgress do maskotCrmEdu,
// escopado por Course (lá era conteúdo global de treinamento interno da equipe).

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  title    String
  order    Int     @default(0)
  active   Boolean @default(true)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
}

model CourseLesson {
  id       String  @id @default(cuid())
  moduleId String
  title    String
  content  String? @db.Text
  videoUrl String?
  videoKey String?
  duration Int?
  order    Int     @default(0)
  active   Boolean @default(true)

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ================================= EVENTO POLIMÓRFICO =================================
// Event = tronco (tipo/local/data/unidade). Cada kind tem uma tabela-filha 1:1:
// TURMA -> Course · ASSEMBLEIA/CONGRESSO/ATUACAO_BRIGADA -> EventOperation · REUNIAO -> Meeting

enum EventKind {
  TURMA
  ASSEMBLEIA
  CONGRESSO
  ATUACAO_BRIGADA
  REUNIAO
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id              String      @id @default(cuid())
  organizationId  String
  kind            EventKind
  title           String
  location        String?
  startDate       DateTime
  endDate         DateTime?
  status          EventStatus @default(SCHEDULED)
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course?
  operation    EventOperation?
  meeting      Meeting?
  files        EventFile[]

  @@index([organizationId])
  @@index([kind])
  @@index([startDate])
}

/// Arquivos/links anexados a qualquer evento (pauta, ata, comprovantes) — genérico,
/// evita reimplementar o módulo Drive inteiro do Maskot para um caso de uso bem mais simples.
model EventFile {
  id               String   @id @default(cuid())
  eventId          String
  name             String
  storageKey       String?
  externalUrl      String?
  uploadedByUserId String
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---- Assembleia / congresso / atuação de brigada ----

model EventOperation {
  id                     String  @id @default(cuid())
  eventId                String  @unique
  /// Decisão 15: só contagem agregada do público, sem registro nominal
  estimatedAudienceCount Int?
  notes                  String? @db.Text

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  designations      Designation[]
  occurrenceReports OccurrenceReport[]
}

enum DesignationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Designation {
  id               String            @id @default(cuid())
  eventOperationId String
  staffMemberId    String
  /// BRIGADISTA, BOMBEIRO, COORDENADOR...
  role             String
  /// Decisão 14: escala com turnos/horários dentro do evento
  shiftStart       DateTime
  shiftEnd         DateTime
  status           DesignationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)
  staffMember    StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([eventOperationId])
  @@index([staffMemberId])
}

model OccurrenceReport {
  id               String   @id @default(cuid())
  eventOperationId String
  /// MEDICAL, SAFETY, BEHAVIORAL, GENERAL...
  type             String
  title            String
  description      String?  @db.Text
  createdByUserId  String
  createdAt        DateTime @default(now())

  eventOperation EventOperation @relation(fields: [eventOperationId], references: [id], onDelete: Cascade)

  @@index([eventOperationId])
}

// ---- Reunião periódica + Google Meet ----

model Meeting {
  id            String  @id @default(cuid())
  eventId       String  @unique
  agenda        String? @db.Text
  /// Ata da reunião
  minutes       String? @db.Text
  meetUrl       String?
  googleEventId String?

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances MeetingAttendance[]
}

model MeetingAttendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus @default(ABSENT)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

// ================================= STAFF (BRIGADISTA/BOMBEIRO) =================================

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffMember {
  id               String      @id @default(cuid())
  /// Decisão 8: mesmo User do sistema, papel acumulado (não duplica cadastro)
  userId           String      @unique
  organizationId   String
  status           StaffStatus @default(ACTIVE)
  /// Decisão 9: promoção para staff é sempre manual, feita pelo admin
  approvedByUserId String
  approvedAt       DateTime    @default(now())

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalCertifications ExternalCertification[]
  designations           Designation[]

  @@index([organizationId])
}

/// Decisão 10: certificação de profissional externo à escola, registro manual pelo admin
model ExternalCertification {
  id                 String    @id @default(cuid())
  staffMemberId      String
  name               String
  issuingOrg         String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  proofFileKey       String?
  registeredByUserId String
  createdAt          DateTime  @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId])
  @@index([expiresAt])
}

// ================================= CERTIFICADO / CRACHÁ =================================
// O "crachá" não é uma tabela própria: a página pública /badge/:token resolve por
// User.publicBadgeToken e lista os Certificate válidos daquele usuário.

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

model Certificate {
  id                        String            @id @default(cuid())
  enrollmentId              String            @unique
  organizationId            String
  issuedAt                  DateTime          @default(now())
  /// Decisões 19/20: reciclagem ativa + válido em toda a rede da organização
  expiresAt                 DateTime?
  status                    CertificateStatus @default(VALID)
  pdfKey                    String?
  /// Decisão 16: emissão automática por critérios da turma
  issuedAutomatically       Boolean           @default(true)
  recycledFromCertificateId String?

  enrollment               Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recycledFromCertificate  Certificate?  @relation("Recycling", fields: [recycledFromCertificateId], references: [id])
  recycledIntoCertificates Certificate[] @relation("Recycling")

  @@index([organizationId])
  @@index([expiresAt])
}

/// Decisão 21: personalização visual (logo, assinatura) por organização já no MVP
model CertificateTemplate {
  id                String  @id @default(cuid())
  organizationId    String  @unique
  logoUrl           String?
  signatureName     String?
  signatureImageUrl String?
  layoutConfig      Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ================================= INTEGRAÇÕES E NOTIFICAÇÕES =================================
// Faltavam no desenho original do schema (lacuna encontrada ao portar auth/google-calendar/
// notifications do maskotCrmEdu): sem UserIntegration não há onde persistir o token OAuth do
// Google Calendar por usuário, e sem Notification não há destino para os alertas de vencimento
// de certificado (decisão 19) nem para notificações gerais (designação, matrícula etc.).

model UserIntegration {
  id             String    @id @default(cuid())
  userId         String
  /// "GOOGLE_CALENDAR" por enquanto; string livre para admitir outros provedores depois
  provider       String
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  /// CERTIFICATE_EXPIRING, DESIGNATION_ASSIGNED, ENROLLMENT_CONFIRMED, GENERAL...
  type           String
  title          String
  message        String?  @db.Text
  link           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
}

// ================================= DISPONIBILIDADE =================================
// Portado do maskotCrmEdu (UserAvailability/TimeOff) sem alteração de forma.
// Visit/EventType/ScheduleSettings NÃO foram portados: são a máquina de agendamento
// público de visita comercial do CRM (lead reserva horário com vendedor), forma
// diferente do que este produto precisa.

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model UserAvailability {
  id             String  @id @default(cuid())
  day            WeekDay
  start          String  @db.Char(5)
  end            String  @db.Char(5)
  userId         String
  organizationId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, day, start, end])
  @@index([userId])
}

model TimeOff {
  id     String   @id @default(cuid())
  start  DateTime
  end    DateTime
  reason String?
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start, end])
}
