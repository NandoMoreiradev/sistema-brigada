# backend/.env.example
# Copie para .env e preencha os valores. Não commitar o .env real.

# --- Servidor ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ENABLE_API_DOCS=true

# --- Banco de dados (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/brigada?schema=public

# --- Autenticação (JWT) ---
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
ACCESS_TOKEN_EXPIRES_IN=15m
JWT_EXPIRES_IN=8h

# --- 2FA (TOTP) ---
# Chave usada para criptografar o secret do TOTP no banco (AES-256-GCM).
# Deve ser uma string base64 que decodifica para exatamente 32 bytes.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_SECRET_KEY=
TWO_FACTOR_SERVICE_NAME=Brigada

# --- Storage (Cloudflare R2, usado por media.service.ts) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Google Calendar (usado por user-integrations/google-calendar) ---
# ATENÇÃO: o fluxo OAuth completo (autorização + persistência de token por
# usuário) ainda não está implementado — falta um model no schema para guardar
# o access/refresh token do Google por usuário. Ver comentário no topo de
# google-calendar.service.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/user-integrations/google/callback

# --- E-mail transacional (Resend) ---
# Usado hoje só pelo fluxo de "esqueci minha senha" (common/email.service.ts).
# Se não configurado, os e-mails são apenas logados (não enviados).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="Brigada <no-reply@example.com>"
